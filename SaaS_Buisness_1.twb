      <aliases enabled='yes' />
      <column caption='Gross RCR (%)' datatype='real' name='[Calculation_152277965080281088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([opening_mrr])=0 THEN NULL&#13;&#10;ELSE ( SUM([churn_mrr]) + SUM([contraction_mrr]) ) / SUM([opening_mrr])&#13;&#10;END' />
      </column>
      <column caption='Net RCR (%)' datatype='real' name='[Calculation_152277965080539137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([opening_mrr])=0 THEN NULL&#13;&#10;ELSE ( SUM([churn_mrr]) + SUM([contraction_mrr]) - SUM([expansion_mrr]) ) / SUM([opening_mrr])&#13;&#10;END' />
      </column>
      <column caption='Gross Retention (%)' datatype='real' name='[Calculation_152277965080690690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_152277965080281088]' />
      </column>
      <column caption='Net retention (%)' datatype='real' name='[Calculation_152277965080813571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_152277965080539137]' />
      </column>
      <column caption='NRR (Agg)' datatype='real' name='[Calculation_718605620730892288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([opening_mrr]) = 0 THEN NULL&#13;&#10;ELSE 1 - ( (SUM([churn_mrr]) + SUM([contraction_mrr]) - SUM([expansion_mrr])) / SUM([opening_mrr]) )&#13;&#10;END' />
      </column>
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_93168222865805312]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [signup_date])' />
      </column>
      <column caption='Active Month' datatype='datetime' name='[Calculation_93168222865977345]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [month_date])' />
      </column>
      <column aggregation='Sum' caption='Months Since Signup' datatype='integer' name='[Calculation_93168222866104322]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_93168222865805312], [Calculation_93168222865977345])' />
      </column>
      <column caption='MRR @ Month 0 (per cohort)' datatype='integer' name='[Calculation_93168222866329603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_93168222865805312] :&#13;&#10;    SUM(&#13;&#10;      IF DATEDIFF(&apos;month&apos;, [Calculation_93168222865805312], [Calculation_93168222865977345]) = 0&#13;&#10;      THEN [closing_mrr]&#13;&#10;      END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Retention % (MRR)' datatype='real' name='[Calculation_93168222866677764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_93168222866329603]) = 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    SUM([closing_mrr]) / SUM([Calculation_93168222866329603])&#13;&#10;END' />
      </column>
      <column caption='[MRR @ Month 0 (per cohort)]' datatype='integer' name='[Calculation_93168222872600581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_93168222865805312] :&#13;&#10;    SUM(&#13;&#10;        IF [Calculation_93168222866104322] = 0 THEN [closing_mrr]&#13;&#10;        ELSE 0 END&#13;&#10;    )&#13;&#10;}' />
      </column>
